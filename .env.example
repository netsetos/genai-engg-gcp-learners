# Copy this file to `.env` and fill in your values.
# Never commit .env — it's in .gitignore.
#
# The course is GCP-native. Authentication is via Application Default
# Credentials (`gcloud auth application-default login` locally, or the
# Colab `auth.authenticate_user()` cell). You should NOT need API keys
# for the core lessons.

# === Required ===
PROJECT_ID=documind-ai-YOUR-ID
REGION=us-central1                # us-central1 = full Gemini / Vertex feature set
                                  # asia-south1 = lower latency from India

# === Optional: only for specific lessons ===

# Lesson 11.3 (LiteLLM) — only if you want to fan out to non-GCP providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Module 9 (Generative Media) — Gemini API direct (alternative to Vertex)
# GOOGLE_API_KEY=

# Module 10 (Tuning) — only if pushing to Hugging Face
# HF_TOKEN=
